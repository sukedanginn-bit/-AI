{
  "name": "roast-world-analyzer",
  "private": true,
  "type": "module",
  "scripts": {
    "check:worker": "node --check worker.js",
    "check:browser": "node scripts/check-browser-js.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "test": "node --test",
    "verify": "npm run check:worker && npm run check:browser && npm run check:routes && npm test",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
